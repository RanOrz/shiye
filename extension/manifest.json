{
  "manifest_version": 3,
  "name": "拾页 · Local Web Clipper",
  "version": "0.1.0",
  "description": "将当前网页或音视频转写保存为本地 Markdown。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:43127/*"],
  "action": {
    "default_title": "拾页",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "MacCtrl+Shift+M"
      }
    }
  }
}
